# COMANDOS API / Oracle
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USERNAME=comandos
ORACLE_PASSWORD=change-me
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false

# Product security / web
ERP_REQUIRE_LOGIN=false
ERP_ENFORCE_PERMISSIONS=false
ERP_ALLOWED_ORIGIN=http://localhost:3000

# Optional demo data
COMANDOS_DEMO_SEED=false
COMANDOS_DEMO_REQUIRE_FULL_COVERAGE=false
COMANDOS_DEMO_MINIMUM_ROWS=3

# Step 21 master-data cutover controls.
# Keep false in ordinary runtime until the controlled migration is executed.
COMANDOS_MASTER_DATA_SHADOW_WRITE=false
COMANDOS_MASTER_DATA_READINESS_ON_STARTUP=false
COMANDOS_MASTER_DATA_BACKFILL_ON_STARTUP=false
COMANDOS_MASTER_DATA_PARITY_ON_STARTUP=false
COMANDOS_MASTER_DATA_CANONICAL_READ=false
COMANDOS_MASTER_DATA_RETIREMENT_VALIDATION_ON_STARTUP=false
COMANDOS_MASTER_DATA_PRODUCT_REFERENCE_SHADOW=false
COMANDOS_MASTER_DATA_PRODUCT_REFERENCE_BACKFILL_ON_STARTUP=false
COMANDOS_MASTER_DATA_PRODUCT_REFERENCE_PRIMARY_READ=false
COMANDOS_MASTER_DATA_LEGACY_PRODUCT_ASSOCIATIONS_RETIRED=false
